/* ESTILOS DE ALTO CONTRASTE (PRETO E ROXO) */
body.high-contrast {
    background-color: #000000 !important;
    color: #ffffff !important;
}

body.high-contrast .hero {
    background: #000000 !important;
    border-bottom: 3px solid #a855f7 !important;
}

body.high-contrast .title-main {
    color: #c084fc !important;
    text-shadow: 0 0 15px rgba(168, 85, 247, 0.6) !important;
}

body.high-contrast .subtitle {
    color: #ffffff !important;
}

body.high-contrast .quote {
    color: #e9d5ff !important;
}

body.high-contrast .card {
    background: #0a0510 !important;
    border: 2px solid #a855f7 !important;
    box-shadow: none !important;
}

body.high-contrast .card h2, 
body.high-contrast .season-box h3,
body.high-contrast .character-box h3,
body.high-contrast .realm-box h3 {
    color: #c084fc !important;
    border-bottom-color: #a855f7 !important;
}

body.high-contrast .card p,
body.high-contrast .season-box p,
body.high-contrast .character-box p,
body.high-contrast .realm-box p {
    color: #ffffff !important;
}

body.high-contrast .season-box,
body.high-contrast .character-box,
body.high-contrast .realm-box,
body.high-contrast .clover-list li {
    background: #000000 !important;
    border: 1px solid #a855f7 !important;
    box-shadow: none !important;
}

body.high-contrast .btn-explore,
body.high-contrast .btn-contrast {
    background-color: #a855f7 !important;
    color: #ffffff !important;
    border: 2px solid #c084fc !important;
    font-weight: 900 !important;
}

body.high-contrast .btn-explore:hover,
body.high-contrast .btn-contrast:hover {
    background-color: #9333ea !important;
}